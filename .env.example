# =========================================================================
# Pixels — frontend environment variables
# Copy this file to `.env` (or `.env.local`) and fill in your keys.
# Everything here is PUBLIC (shipped to the browser). Real secrets live in
# the Cloudflare Worker — see worker/README.md.
# All values are OPTIONAL: the app runs without them (game data falls back to
# a bundled list; Steam/Turnstile hide themselves).
# =========================================================================

# --- Live game data (RAWG) --------------------------------------------------
# Free key from https://rawg.io/apidocs — powers trending/search game data.
# Without it the app falls back to a curated Steam list, then bundled mock data.
VITE_RAWG_API_KEY=""

# --- Steam import (optional, via a Cloudflare Worker) -----------------------
# Base URL of your deployed Cloudflare Worker (no trailing slash), e.g.
# https://pixels-api.your-subdomain.workers.dev
# Enables the "Continue with Steam" button + Turnstile verification.
# Leave blank to hide Steam sign-in. See worker/README.md.
VITE_WORKER_URL=""

# --- Cloudflare Turnstile (bot check on login) -----------------------------
# Site key (public) from the Cloudflare dashboard -> Turnstile.
# The matching SECRET key goes in the Worker. Leave blank to hide the check.
VITE_TURNSTILE_SITE_KEY=""

# --- Web push notifications (Firebase Cloud Messaging) ----------------------
# Public VAPID key: Firebase Console -> Project settings -> Cloud Messaging ->
# Web Push certificates. Leave blank to hide the "enable notifications" button.
# Sending pushes also needs FIREBASE_SERVICE_ACCOUNT set in the Netlify env.
VITE_FIREBASE_VAPID_KEY=""

# --- Steam sign-in (via the built-in Netlify Function) ----------------------
# Set to "1" to show the "Continue with Steam" button. The server side needs a
# STEAM_API_KEY environment variable set in Netlify (https://steamcommunity.com/dev/apikey).
VITE_ENABLE_STEAM_LOGIN=""
